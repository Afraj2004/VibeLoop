# Copy to server/.env and fill in. Never commit the real .env.

PORT=5000
NODE_ENV=development

# Required: long random string (e.g. `openssl rand -hex 32`). The server refuses to start without it.
JWT_SECRET=

# PostgreSQL connection (Supabase / managed Postgres). Run `node migrate.js` after changing schema.sql.
DATABASE_URL=postgresql://user:password@host:5432/vibeloop

# Redis (matchmaking queues, Meet-to-Earn counters, rate limits)
REDIS_URL=redis://127.0.0.1:6379

# Comma-separated client origins allowed by CORS/Socket.IO. Unset = allow all (local dev only).
CLIENT_ORIGINS=https://your-app.vercel.app

# Reverse-proxy hop count so rate limits see the real client IP. Set to 1 on Render; unset when exposed directly.
TRUST_PROXY=

# TURN relay (needed for mobile data / strict NATs). First configured provider wins; none = STUN only.
# Option A: Cloudflare Realtime TURN (no server to run; first 1,000 GB/month free).
# Create a TURN key in Cloudflare dashboard > Realtime > TURN Server.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# Option B: self-hosted coturn. Must match coturn's --static-auth-secret.
TURN_SECRET=
TURN_URLS=turn:turn.vibeloop.app:3478?transport=udp,turn:turn.vibeloop.app:3478?transport=tcp
TURN_TTL=3600
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
